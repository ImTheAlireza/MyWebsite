# Runtime database and SQLite journal files
data/*.sqlite
data/*.sqlite-*
data/.portfolio.sqlite
data/.portfolio.sqlite-*
data/.content-*
# Local secret generated on first run (never commit this)
data/.jwt-secret

# Server logs are generated at runtime and may contain paths — never commit them
error_log

# Node tooling used for local verification — never part of the site
node_modules/
# generated by npm during local verification
data/.npm-cache/
